+    /** Prepare immutable syntax once per list query; all card properties remain live. */
+    public static java.util.function.Predicate<Card> validityPredicate(final String restrictions,
+            final Player sourceController, final Card source, final CardTraitBase spellAbility) {
+        final String[] clauses = restrictions.split(",");
+        final ParsedValidity[] parsed = new ParsedValidity[clauses.length];
+        for (int i = 0; i < clauses.length; i++) {
+            parsed[i] = VALIDITY_SYNTAX.getUnchecked(clauses[i]);
+        }
+        return card -> {
+            if (card == null) return false;
+            for (ParsedValidity clause : parsed) {
+                if (card.matchesParsedValidity(clause, sourceController, source, spellAbility)) return true;
+            }
+            return false;
+        };
+    }
