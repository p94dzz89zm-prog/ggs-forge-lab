+    private void assertContinuousDiscoveryMatches(Card host) {
+        var expected=new FCollection<StaticAbility>();
+        for(var ability:host.getStaticAbilities()) {
+            if(ability.checkMode(forge.game.staticability.StaticAbilityMode.Continuous) && ability.zonesCheck())expected.add(ability);
+        }
+        var actual=new FCollection<StaticAbility>();host.getCurrentState().collectActiveContinuousStaticAbilities(actual);
+        Assert.assertEquals(new ArrayList<>(actual),new ArrayList<>(expected));
+    }
+    @Test public void continuousDiscoveryKeepsLiveModesZonesPhasingAndMembership() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);Card host=addCard("Grizzly Bears",player);
+        StaticAbility first=trait(host,"Creature"),second=trait(host,"Creature.YouCtrl");host.addStaticAbility(first);host.addStaticAbility(second);
+        host.addStaticAbility("Mode$ CantBlock | ValidCard$ Card.Self");assertContinuousDiscoveryMatches(host);
+        var saved=new FCollection<StaticAbility>();host.getCurrentState().collectActiveContinuousStaticAbilities(saved);
+        host.getCurrentState().removeStaticAbility(first);assertContinuousDiscoveryMatches(host);Assert.assertTrue(saved.contains(first));
+        second.setActiveZone(java.util.EnumSet.of(ZoneType.Graveyard));assertContinuousDiscoveryMatches(host);
+        player.getZone(ZoneType.Battlefield).remove(host);player.getZone(ZoneType.Graveyard).add(host);assertContinuousDiscoveryMatches(host);
+        host.setPhasedOut(player);assertContinuousDiscoveryMatches(host);host.setPhasedOut(null);assertContinuousDiscoveryMatches(host);
+    }
+    @Test public void continuousDiscoveryKeepsGrantedAndRemovedTraits() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        var intrinsic=trait(host,"Creature");host.addStaticAbility(intrinsic);assertContinuousDiscoveryMatches(host);
+        var granted=trait(host,"Creature.YouCtrl");
+        host.addChangedCardTraits(List.of(),List.of(),List.of(),List.of(granted),ability -> true,1L,1L,false);
+        assertContinuousDiscoveryMatches(host);
+        var result=new FCollection<StaticAbility>();host.getCurrentState().collectActiveContinuousStaticAbilities(result);
+        Assert.assertTrue(result.contains(granted));Assert.assertFalse(result.contains(intrinsic));
+        host.removeChangedCardTraits(1L,1L);assertContinuousDiscoveryMatches(host);
+    }
+    @Test public void continuousDiscoveryKeepsKeywordAndSplitStateTraits() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        host.addIntrinsicKeyword("Flying");
+        var keyword=host.getCurrentState().getCachedKeywords().getValues().iterator().next();keyword.addStaticAbility(trait(host,"Creature"));
+        assertContinuousDiscoveryMatches(host);
+        Card split=addCard("Fire",game.getPlayers().get(0));
