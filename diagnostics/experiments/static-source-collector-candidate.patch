+    /** Collect for this rebuild only; never expose or retain the intrinsic collection. */
+    public final void collectActiveContinuousStaticAbilities(FCollection<StaticAbility> result) {
+        final FCollectionView<StaticAbility> abilities;
+        if (!hasCombinedSplitTraits() && !card.hasChangedTraitEffects()
+                && !card.hasRemoveIntrinsic() && !cachedKeywords.hasStaticAbilities()) {
+            abilities = staticAbilities;
+        } else {
+            abilities = getStaticAbilities();
+        }
+        for (StaticAbility ability : abilities) {
+            if (ability.checkMode(StaticAbilityMode.Continuous) && ability.zonesCheck()) {
+                result.add(ability);
+            }
+        }
+    }
