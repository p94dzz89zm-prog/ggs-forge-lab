+    @Test public void stackCandidateDiscoveryKeepsOwnAndBorrowedSpellChecks() {
+        var game=initAndCreateGame();var owner=game.getPlayers().get(0);var other=game.getPlayers().get(1);
+        Card ezio=addCard("Ezio Auditore da Firenze",owner);
+        Card own=addCardToZone("Grizzly Bears",owner,ZoneType.Hand);
+        Card opposing=addCardToZone("Grizzly Bears",other,ZoneType.Hand);
+        Assert.assertTrue(game.getAction().hasStaticAbilityAffectingZone(ZoneType.Stack,forge.game.staticability.StaticAbilityLayer.ABILITIES));
+        Assert.assertTrue(game.getAction().hasStaticAbilityAffectingStackCandidate(own,owner));
+        Assert.assertFalse(game.getAction().hasStaticAbilityAffectingStackCandidate(opposing,other));
+        Assert.assertTrue(game.getAction().hasStaticAbilityAffectingStackCandidate(opposing,owner));
+        Card copy=forge.game.card.CardCopyService.getLKICopy(opposing);
