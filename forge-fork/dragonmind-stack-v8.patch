index 85f0f49..1dd4b77 100644
--- a/forge-game/src/main/java/forge/game/GameAction.java
+++ b/forge-game/src/main/java/forge/game/GameAction.java
@@ -1067,6 +1067,133 @@ public class GameAction {
         return false;
     }
 
+    /**
+     * Conservative stack discovery: reject only controller-restricted grants
+     * belonging to another player. Do not predict future spell types or costs.
+     */
+    public boolean hasStaticAbilityAffectingStackCandidate(Card candidate, Player activator) {
+        if (Boolean.getBoolean("dragonmind.disableStackCandidateFilter")
+                || candidate.isLKI() || candidate.getController() != activator) {
+            return hasStaticAbilityAffectingZone(ZoneType.Stack, StaticAbilityLayer.ABILITIES);
+        }
+        if (!hasStaticAbilityAffectingZone(ZoneType.Stack, StaticAbilityLayer.ABILITIES)) return false;
+        final boolean[] unsafe = {false};
+        // Match the rebuild's world traversal, including hand/library and
+        // hidden traits. Do not omit currently inactive effects: moving the
+        // hypothetical spell can change their conditions or effect zones.
+        game.forEachCardInGame(card -> {
+            for (StaticAbility ability : card.getStaticAbilities()) {
+                if (unsafeStackCandidateFilter(ability, candidate)) { unsafe[0] = true; return false; }
+            }
+            for (StaticAbility ability : card.getHiddenStaticAbilities()) {
+                if (unsafeStackCandidateFilter(ability, candidate)) { unsafe[0] = true; return false; }
+            }
+            return true;
+        }, true);
+        return unsafe[0];
+    }
+
+    private static boolean unsafeStackCandidateFilter(StaticAbility ability, Card candidate) {
+        if (!ability.checkMode(StaticAbilityMode.Continuous)) return false;
+        if (ability.getLayers().contains(StaticAbilityLayer.CONTROL)
+                || ability.getLayers().contains(StaticAbilityLayer.COPY)
+                || ability.getLayers().contains(StaticAbilityLayer.TEXT)
+                || (ability.hasParam("AddStaticAbility") && !onlyGeneratesBattlefieldCombatBonuses(ability))
+                || (ability.hasParam("AddSVar") && !onlyAddsBlockingDirective(ability))
+                || ability.hasParam("GainsAbilitiesOf")
+                || ability.hasParam("GainsAbilitiesOfDefined") || ability.hasParam("ShareRememberedKeywords")) return true;
+        boolean explicitlyIncludesStack = ZoneType.listValueOf(ability.getParamOrDefault("AffectedZone",
+            ZoneType.Battlefield.toString())).contains(ZoneType.Stack);
+        // Defined-card/CDA selection can bypass ordinary affected-zone filtering.
+        if (!explicitlyIncludesStack && (ability.hasParam("AffectedDefined") || ability.isCharacteristicDefining())
+                && ability.getLayers().contains(StaticAbilityLayer.ABILITIES)
+                && !onlyChangesCombatTraits(ability)) return true;
+        return ability.getLayers().contains(StaticAbilityLayer.ABILITIES)
+            && explicitlyIncludesStack
+            && (ability.isCharacteristicDefining()
+                || ability.getHostCard().getController() == candidate.getController()
+                || !onlyAffectsControllerCards(ability));
+    }
+
+    private static boolean onlyChangesCombatTraits(StaticAbility ability) {
+        for (String key : ability.getMapParams().keySet()) {
+            switch (key) {
+                case "Mode", "Affected", "AffectedDefined", "AffectedZone", "EffectZone", "CharacteristicDefining",
+                    "AddPower", "AddToughness", "SetPower", "SetToughness", "AddType", "RemoveType",
+                    "RemoveCardTypes", "AddKeyword", "AddTrigger", "AddStaticAbility", "AddSVar", "Description",
+                    "Condition", "CheckSVar", "SVarCompare": break;
+                default: return false;
+            }
+        }
+        if (!ability.hasParam("AddKeyword")) return true;
+        for (String keyword : ability.getParam("AddKeyword").split(" & ")) {
+            switch (keyword) {
+                case "Haste", "Trample", "Hexproof", "Indestructible", "Flying", "First strike", "Double strike",
+                    "Menace", "Vigilance", "Lifelink", "Deathtouch", "Shroud", "Reach", "Skulk", "Fear", "Intimidate": break;
+                default: if (!keyword.startsWith("Protection:") && !keyword.startsWith("Protection from ")) return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean onlyAddsBlockingDirective(StaticAbility ability) {
+        for (String name : ability.getParam("AddSVar").split(" & ")) {
+            if (!"SVar:MustBeBlocked:AttackingPlayerConservative".equals(AbilityUtils.getSVar(ability, name))) return false;
+        }
+        return true;
+    }
+
+    private static boolean onlyGeneratesBattlefieldCombatBonuses(StaticAbility ability) {
+        // Inspect script data without constructing traits or advancing IDs.
+        // Unknown/generated behavior keeps the original rebuild.
+        try {
+            for (String name : ability.getParam("AddStaticAbility").split(" & ")) {
+                Map<String, String> params = forge.util.FileSection.parseToMap(
+                    AbilityUtils.getSVar(ability, name), forge.util.FileSection.DOLLAR_SIGN_KV_SEPARATOR);
+                if (!"Continuous".equals(params.get("Mode"))
+                        || !"Battlefield".equals(params.getOrDefault("AffectedZone", "Battlefield"))) return false;
+                for (String key : params.keySet()) {
+                    switch (key) {
+                        case "Mode", "Affected", "AffectedDefined", "AffectedZone", "EffectZone",
+                            "AddPower", "AddToughness", "SetPower", "SetToughness", "AddKeyword",
+                            "Description", "Condition", "CheckSVar", "SVarCompare": break;
+                        default: return false;
+                    }
+                }
+                if (params.containsKey("AddKeyword")) {
+                    for (String keyword : params.get("AddKeyword").split(" & ")) {
+                        if (!keyword.equals("Haste") && !keyword.equals("Trample")) return false;
+                    }
+                }
+            }
+            return true;
+        } catch (RuntimeException uncertainScript) {
+            return false;
+        }
+    }
+
+    private static boolean onlyAffectsControllerCards(StaticAbility ability) {
+        // MayPlay validity has special ownership handling (Shaman's Trance).
+        if (!ability.hasParam("Affected") || ability.hasParam("MayPlay")) return false;
+        for (String branch : ability.getParam("Affected").split(",", -1)) {
+            String[] parts = branch.split("\\.", -1);
+            if (parts.length != 2) return false;
+            switch (parts[0]) {
+                case "Card", "Creature", "Artifact", "Enchantment", "Instant", "Sorcery",
+                        "Planeswalker", "Land", "Battle", "Permanent": break;
+                default: return false;
+            }
+            boolean restricted = false;
+            for (String property : parts[1].split("\\+", -1)) {
+                if (property.equals("YouCtrl")) restricted = true;
+            }
+            // Comma-separated validity branches are alternatives: each must
+            // contain the positive, exact YouCtrl constraint.
+            if (!restricted) return false;
+        }
+        return true;
+    }
+
     public final void checkStaticAbilities() {
         checkStaticAbilities(true);
     }
