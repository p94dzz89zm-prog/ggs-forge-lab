diff --git a/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java b/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java
new file mode 100644
--- /dev/null
+++ b/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java
@@ -0,0 +1,54 @@
+package forge.ai;
+
+import forge.game.card.Card;
+import forge.game.keyword.KeywordCollection;
+import forge.game.keyword.KeywordInterface;
+import forge.game.staticability.StaticAbility;
+import forge.game.staticability.StaticAbilityContinuous;
+import java.util.*;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+
+public class DragonMindPerformanceTest extends AITest {
+    private StaticAbility trait(Card host, String affected) {
+        return StaticAbility.create("Mode$ Continuous | Affected$ "+affected+" | AddPower$ 1",host,host.getCurrentState(),true);
+    }
+    private List<StaticAbility> applied(KeywordCollection collection) {
+        return collection.applyStaticAbility(new ArrayList<>());
+    }
+    @Test public void membershipAndMutableTraitsStayCurrent() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        KeywordCollection keywords=new KeywordCollection();KeywordInterface flying=keywords.add("Flying");
+        Assert.assertTrue(applied(keywords).isEmpty());
+        StaticAbility first=trait(host,"Creature");flying.addStaticAbility(first);
+        Assert.assertEquals(applied(keywords),List.of(first));
+        KeywordInterface haste=keywords.add("Haste");StaticAbility second=trait(host,"Creature.YouCtrl");haste.addStaticAbility(second);
+        Assert.assertEquals(new HashSet<>(applied(keywords)),Set.of(first,second));
+        keywords.removeInstances(List.of(flying));Assert.assertEquals(applied(keywords),List.of(second));
+        keywords.clear();Assert.assertTrue(applied(keywords).isEmpty());
+    }
+    @Test public void retainedLiveViewMutationsRemainVisible() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        KeywordCollection keywords=new KeywordCollection();KeywordInterface flying=keywords.add("Flying");
+        flying.addStaticAbility(trait(host,"Creature"));var live=keywords.getValues();
+        Assert.assertEquals(applied(keywords).size(),1);live.remove(flying);
+        Assert.assertTrue(applied(keywords).isEmpty());
+        keywords.insert(flying);Assert.assertEquals(applied(keywords).size(),1);
+        live.clear();Assert.assertTrue(applied(keywords).isEmpty());
+    }
+    @Test public void iteratorRemovalInvalidatesMembership() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        KeywordCollection keywords=new KeywordCollection();keywords.add("Flying").addStaticAbility(trait(host,"Creature"));
+        Assert.assertEquals(applied(keywords).size(),1);var iterator=keywords.iterator();iterator.next();iterator.remove();
+        Assert.assertTrue(applied(keywords).isEmpty());
+    }
+    @Test public void playerEffectsStillSelectValidPlayers() throws Exception {
+        var game=initAndCreateGame();var controller=game.getPlayers().get(0);Card host=addCard("Grizzly Bears",controller);
+        var method=StaticAbilityContinuous.class.getDeclaredMethod("getAffectedPlayers",StaticAbility.class);method.setAccessible(true);
+        for(String restriction:List.of("Player","You","Opponent","Any","Creature","Card.Player","Creature,Player")) {
+            var expected=new ArrayList<>();
+            for(var player:game.getPlayersInTurnOrder())if(player.isValid(restriction.split(","),controller,host,null))expected.add(player);
+            Assert.assertEquals(method.invoke(null,trait(host,restriction)),expected,restriction);
+        }
+    }
+}
