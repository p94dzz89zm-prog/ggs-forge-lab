+    @Test public void affectedCardsResultsOwnMembershipAndRespectIgnoredCards() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card host=addCardToZone("Grizzly Bears",player,ZoneType.Hand);
+        player.getZone(ZoneType.Hand).remove(host);game.getStackZone().add(host);
+        for(String affected:List.of("", " | Affected$ Creature")) {
+            var ability=new StaticAbility("Mode$ Continuous | AffectedZone$ Stack | AddPower$ 1"+affected,host,host.getCurrentState());
+            var result=StaticAbilityContinuous.getAffectedCards(ability,forge.game.card.CardCollection.EMPTY);
+            Assert.assertTrue(result.contains(host));
+            ((forge.game.card.CardCollection)result).clear();
+            Assert.assertTrue(game.getCardsIn(ZoneType.Stack).contains(host));
+            ability.setIgnoreEffectCards(new forge.game.card.CardCollection(host));
+            Assert.assertTrue(StaticAbilityContinuous.getAffectedCards(ability,forge.game.card.CardCollection.EMPTY).isEmpty());
+            Assert.assertTrue(game.getCardsIn(ZoneType.Stack).contains(host));
+        }
+    }
+    @Test public void affectedCardsRejectInvalidHypotheticalBeforeSameIdLiveCard() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        var virtual=forge.game.card.CardCopyService.getLKICopy(host);
+        var type=new forge.card.CardType(false);type.add("Artifact");virtual.getCurrentState().setType(type);
+        var ability=new StaticAbility("Mode$ Continuous | Affected$ Creature | AddPower$ 1",host,host.getCurrentState());
+        Assert.assertTrue(StaticAbilityContinuous.getAffectedCards(ability,new forge.game.card.CardCollection(virtual)).isEmpty());
+        Assert.assertTrue(StaticAbilityContinuous.getAffectedCards(ability,forge.game.card.CardCollection.EMPTY).contains(host));
+    }
+    @Test public void affectedDefinedKeepsVirtualPriorityAndOwnedResult() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        var virtual=forge.game.card.CardCopyService.getLKICopy(host);
+        var ability=new StaticAbility("Mode$ Continuous | AffectedDefined$ Self | AddPower$ 1",host,host.getCurrentState());
+        var result=StaticAbilityContinuous.getAffectedCards(ability,new forge.game.card.CardCollection(virtual));
+        Assert.assertEquals(result.size(),1);Assert.assertSame(result.get(0),virtual);
+        ((forge.game.card.CardCollection)result).clear();
+        Assert.assertSame(StaticAbilityContinuous.getAffectedCards(ability,forge.game.card.CardCollection.EMPTY).get(0),host);
+    }
