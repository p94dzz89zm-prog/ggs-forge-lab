+        var game=initAndCreateGame();var player=game.getPlayers().get(0);var other=game.getPlayers().get(1);
+        Card host=addCard("Grizzly Bears",player),own=addCardToZone("Grizzly Bears",player,ZoneType.Graveyard);
+        Card opposing=addCardToZone("Grizzly Bears",other,ZoneType.Graveyard);
