+            }
+            Assert.assertTrue(handler.getReadOnlyCombatTraitSources(ZoneType.Battlefield,true).contains(host));
+        }
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertTrue(handler.getReadOnlyCombatTraitSources(ZoneType.Battlefield,true).contains(host));
+            player.getZone(ZoneType.Battlefield).remove(host);
+            Assert.assertFalse(handler.getReadOnlyCombatTraitSources(ZoneType.Battlefield,true).contains(host));
+            player.getZone(ZoneType.Battlefield).add(host);
+            Assert.assertTrue(handler.getReadOnlyCombatTraitSources(ZoneType.Battlefield,true).contains(host));
+        }
