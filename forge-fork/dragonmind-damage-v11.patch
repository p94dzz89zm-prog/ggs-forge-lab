+    @Test public void damageRuleQueriesKeepModesAndValidityFresh() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card host=addCard("Grizzly Bears",player),body=addCard("Grizzly Bears",player);
+        var handler=game.getReplacementHandler();
+        for (String mode : List.of("AssignNoCombatDamage","CombatDamageToughness","CombatDamageNegatePower","AssignCombatDamageAsUnblocked","CantPreventDamage")) {
+            var ability=host.addStaticAbility("Mode$ "+mode+" | ValidCard$ Card.Other | ValidSource$ Card.Other");
+            try(var scope=handler.beginReadOnlyCombatInspection()) {
+                Assert.assertTrue(damageRuleQuery(mode,body));
+                ability.putParam("ValidCard","Card.Self");ability.putParam("ValidSource","Card.Self");
+                Assert.assertFalse(damageRuleQuery(mode,body));
+                ability.putParam("ValidCard","Card.Other");ability.putParam("ValidSource","Card.Other");
+                Assert.assertTrue(damageRuleQuery(mode,body));
+                ability.setMode(java.util.EnumSet.of(forge.game.staticability.StaticAbilityMode.CantAttack));
+                Assert.assertFalse(damageRuleQuery(mode,body));
+            }
+            host.getCurrentState().removeStaticAbility(ability);
+        }
+    }
+    private boolean damageRuleQuery(String mode,Card card) {
+        return switch(mode) {
+            case "AssignNoCombatDamage" -> card.assignNoCombatDamage();
+            case "CombatDamageToughness" -> card.toughnessAssignsDamage();
+            case "CombatDamageNegatePower" -> card.negateCombatAssignedDamage();
+            case "CantPreventDamage" -> !card.canDamagePrevented(true);
+            default -> forge.game.staticability.StaticAbilityAssignCombatDamageAsUnblocked.assignCombatDamageAsUnblocked(card,false);
+        };
+    }
