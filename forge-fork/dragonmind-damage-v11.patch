+        Card body=addCard("Grizzly Bears",player);var virtual=forge.game.card.CardCopyService.getLKICopy(body);
+        virtual.addStaticAbility("Mode$ AssignNoCombatDamage | ValidCard$ Card.Self");
+        virtual.addStaticAbility("Mode$ CantPreventDamage | ValidSource$ Card.Self");
+        try(var scope=game.getReplacementHandler().beginReadOnlyCombatInspection()) {
+            // The original complete-zone list keeps the real card before the same-id LKI.
