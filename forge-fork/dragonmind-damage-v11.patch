+            Assert.assertFalse(body.assignNoCombatDamage());Assert.assertTrue(body.canDamagePrevented(true));
+        }
+    }
+    @Test public void replacementRuleSourcesPreserveOrderPhasingAndNestedAdditions() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card host=addCard("Grizzly Bears",player),empty=addCard("Grizzly Bears",player);
+        Card command=addCardToZone("Grizzly Bears",player,ZoneType.Command);
+        host.addReplacementEffect(forge.game.replacement.ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Battlefield | Prevent$ True",host,false,null));
+        command.addReplacementEffect(forge.game.replacement.ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Command | Prevent$ True",command,false,null));
+        var handler=game.getReplacementHandler();
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertEquals(new ArrayList<>(handler.getReadOnlyCombatReplacementRuleSources()),List.of(host,command));
+            try(var nested=handler.beginReadOnlyCombatInspection()) {
+                empty.addReplacementEffect(forge.game.replacement.ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Battlefield | Prevent$ True",empty,false,null));
+            }
+            Assert.assertTrue(handler.getReadOnlyCombatReplacementRuleSources().contains(empty));
+            empty.setPhasedOut(player);Assert.assertFalse(handler.getReadOnlyCombatReplacementRuleSources().contains(empty));
+            empty.setPhasedOut(null);Assert.assertTrue(handler.getReadOnlyCombatReplacementRuleSources().contains(empty));
+            player.getZone(ZoneType.Battlefield).remove(empty);Assert.assertFalse(handler.getReadOnlyCombatReplacementRuleSources().contains(empty));
+        }
+    }
+    @Test public void preventionRuleIndexKeepsAmountsConditionsAndOptOutFresh() {
