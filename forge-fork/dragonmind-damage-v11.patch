+        Card target=addCard("Grizzly Bears",player),source=addCard("Grizzly Bears",player);
+        var effect=forge.game.replacement.ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Battlefield | PreventionEffect$ True | ValidTarget$ Card.Self",target,false,null);
+        var ability=forge.game.ability.AbilityFactory.getAbility("DB$ ReplaceDamage | Amount$ 2",target);
+        effect.setOverridingAbility(ability);target.addReplacementEffect(effect);
+        var handler=game.getReplacementHandler();
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertEquals(target.staticDamagePrevention(5,0,source,true,false),3);
+            ability.putParam("Amount","4");Assert.assertEquals(target.staticDamagePrevention(5,0,source,true,false),1);
+            effect.putParam("ValidTarget","Card.Other");Assert.assertEquals(target.staticDamagePrevention(5,0,source,true,false),5);
+            String previous=System.getProperty("dragonmind.disableCombatReplacementRuleIndex");
+            try {
+                System.setProperty("dragonmind.disableCombatReplacementRuleIndex","true");
+                Assert.assertEquals(new ArrayList<>(handler.getReadOnlyCombatReplacementRuleSources()),new ArrayList<>(game.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)));
+                Assert.assertEquals(target.staticDamagePrevention(5,0,source,true,false),5);
+            } finally {
+                if(previous==null)System.clearProperty("dragonmind.disableCombatReplacementRuleIndex");else System.setProperty("dragonmind.disableCombatReplacementRuleIndex",previous);
+            }
+        }
+    }
