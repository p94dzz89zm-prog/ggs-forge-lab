+++ b/forge-gui-desktop/src/test/java/forge/ai/ggs/GgsPilotTest.java
@@ -0,0 +1,145 @@
+package forge.ai.ggs;
+
+import forge.ai.*;
+import forge.game.Game;
+import forge.game.card.*;
+import forge.game.combat.Combat;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import org.testng.Assert;
+import org.testng.annotations.*;
+import java.util.List;
+
+public class GgsPilotTest extends AITest {
+    @AfterMethod(alwaysRun=true) public void clear(){System.clearProperty("forge.ai.ggsPilotPlayer");}
+    private void enable(Player ai){System.setProperty("forge.ai.ggsPilotPlayer",ai.getName());}
+    private SpellAbility ninja(Player ai,String name){
+        Card c=addCardToZone(name,ai,ZoneType.Hand);
+        SpellAbility sa=ComputerUtilAbility.getSpellAbilities(new CardCollection(c),ai).stream().filter(SpellAbility::isNinjutsu).findFirst().orElseThrow();
+        sa.setActivatingPlayer(ai);return sa;
+    }
+    private Combat attack(Game game,Player ai,Card attacker,Player opponent){
+        attacker.setSickness(false);
+        game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS,ai);
+        Combat combat=new Combat(ai);combat.addAttacker(attacker,opponent);combat.setBlocked(attacker,false);
+        game.getPhaseHandler().setCombat(combat);game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_BLOCKERS,ai,false);
+        attacker.setTurnInZone(game.getPhaseHandler().getTurn()-1);return combat;
+    }
+    @Test public void equalManaValueDrawUpgradeChangesStockDecision(){
+        Game g=initAndCreateGame();Player ai=g.getPlayers().get(1);addCard("Island",ai);
+        Card bear=addCard("Runeclaw Bear",ai);attack(g,ai,bear,g.getPlayers().get(0));SpellAbility sa=ninja(ai,"Moon-Circuit Hacker");
+        AiController pilot=((PlayerControllerAi)ai.getController()).getAi();
+        Assert.assertEquals(pilot.canPlaySa(sa),AiPlayDecision.CantPlayAi);
+        enable(ai);Assert.assertTrue(pilot.canPlaySa(sa).willingToPlay());
+    }
+    @Test public void choosesDifferentDefenderForAdditionalDragonInsteadOfLowestPower(){
+        Game g=initAndCreateThreePlayerGame();Player ai=g.getPlayers().get(1),a=g.getPlayers().get(0),b=g.getPlayers().get(2);
+        addCard("Goro-Goro and Satoru",ai);Card bear=addCard("Runeclaw Bear",ai);Combat combat=attack(g,ai,bear,b);
+        Card chick=addCard("Phoenix Chick",ai);chick.setSickness(false);chick.setTurnInZone(g.getPhaseHandler().getTurn());combat.addAttacker(chick,a);combat.setBlocked(chick,false);
+        SpellAbility sa=ninja(ai,"Moon-Circuit Hacker");
+        CardCollection stock=ComputerUtil.chooseReturnType(ai,"Creature.YouCtrl+attacking+unblocked",sa.getHostCard(),null,1,sa);
+        Assert.assertEquals(stock.getFirst(),chick);
+        enable(ai);var plan=GgsNinjutsuPolicy.choose(ai,sa,combat.getUnblockedAttackers());
+        Assert.assertEquals(plan.returned(),bear);Assert.assertEquals(plan.dragonBonus(),90);
+        Assert.assertEquals(ComputerUtil.chooseReturnType(ai,"Creature.YouCtrl+attacking+unblocked",sa.getHostCard(),null,1,sa).getFirst(),bear);
+    }
+    @Test public void doesNotDoubleCountFreshAttackerAgainstSamePlayer(){
+        Game g=initAndCreateGame();Player ai=g.getPlayers().get(1),opp=g.getPlayers().get(0);
