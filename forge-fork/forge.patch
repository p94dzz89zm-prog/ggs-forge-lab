+package forge.ai.bridge;
+
+import com.google.gson.*;
+import forge.ai.AITest;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.combat.Combat;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import org.testng.Assert;
+import org.testng.annotations.*;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.Function;
+
+public class BridgeEngineTest extends AITest {
+    private final ExecutorService clients=Executors.newCachedThreadPool();
+    @AfterMethod(alwaysRun=true) public void clearProperties(){
+        for(String key:new String[]{"forge.bridge.player","forge.bridge.directory","forge.audit.directory","forge.bridge.timeoutSeconds"})System.clearProperty(key);
+    }
+    @AfterClass(alwaysRun=true) public void closeClients(){clients.shutdownNow();}
+    private PlayerControllerBridge remote(Player p,Path dir){
+        System.setProperty("forge.bridge.player",p.getName());System.setProperty("forge.bridge.directory",dir.toString());
+        System.setProperty("forge.bridge.timeoutSeconds","5");
+        PlayerControllerBridge bridge=new PlayerControllerBridge(p.getGame(),p,p.getLobbyPlayer());p.dangerouslySetController(bridge);return bridge;
+    }
+    private Future<?> reply(Path dir,Function<JsonObject,JsonObject> responder,int requests){
+        return clients.submit(()->{
+            String last="";long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(15);
+            try{
+                int done=0;
+                while(done<requests && System.nanoTime()<deadline){
+                    Path file=dir.resolve("request.json");
+                    if(Files.exists(file)){
+                        JsonObject q=JsonParser.parseString(Files.readString(file)).getAsJsonObject();String id=q.get("request_id").getAsString();
+                        if(!id.equals(last)){JsonObject r=responder.apply(q);r.addProperty("request_id",id);BridgeChannel.writeAtomic(dir.resolve("response.json"),r.toString());last=id;done++;}
+                    }
+                    Thread.sleep(10);
+                }
+                if(done!=requests)throw new AssertionError("Missing bridge requests");
+            }catch(Exception e){throw new RuntimeException(e);}
+        });
+    }
+    @Test public void snapshotDoesNotRevealOpponentHandOrLibrary(){
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        addCardToZone("Lightning Bolt",me,ZoneType.Hand);addCardToZone("Demonic Tutor",me,ZoneType.Library);
+        addCardToZone("Thassa's Oracle",opp,ZoneType.Hand);addCardToZone("Force of Will",opp,ZoneType.Library);
+        String state=BridgeSnapshot.forPlayer(me).toString();Assert.assertTrue(state.contains("Lightning Bolt"));
+        for(String secret:new String[]{"Demonic Tutor","Thassa's Oracle","Force of Will"})Assert.assertFalse(state.contains(secret),secret);
+    }
+    @Test public void snapshotHidesOpponentFaceDownIdentity(){
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        Card c=addCard("Fallen Shinobi",opp);c.turnFaceDown(true);
+        String state=BridgeSnapshot.forPlayer(me).toString();Assert.assertFalse(state.contains("Fallen Shinobi"));Assert.assertTrue(state.contains("Face-down card"));
+    }
+    @Test public void externalChoiceCastsAndResolvesRealLightningBolt()throws Exception{
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        addCard("Mountain",me);Card bolt=addCardToZone("Lightning Bolt",me,ZoneType.Hand);
+        Path dir=Files.createTempDirectory("forge-bridge-bolt");PlayerControllerBridge bridge=remote(me,dir);
+        Future<?> client=reply(dir,q->{
+            JsonObject r=new JsonObject();String kind=q.get("kind").getAsString();
+            if(kind.equals("priority")){
+                for(JsonElement e:q.getAsJsonArray("options")){JsonObject o=e.getAsJsonObject();if(o.get("name").getAsString().equals("Lightning Bolt")){r.addProperty("index",o.get("index").getAsInt());return r;}}
+                throw new AssertionError("Bolt not offered");
+            }
+            if(kind.equals("targets")){
+                JsonArray indices=new JsonArray();for(JsonElement e:q.getAsJsonArray("options")){JsonObject o=e.getAsJsonObject();if(o.get("id").getAsInt()==opp.getId())indices.add(o.get("index").getAsInt());}
+                r.add("indices",indices);return r;
+            }throw new AssertionError("Unexpected request "+kind);
+        },2);
+        List<SpellAbility> selected=bridge.chooseSpellAbilityToPlay();Assert.assertEquals(selected.size(),1);
+        Assert.assertTrue(bridge.playChosenSpellAbility(selected.get(0)));game.getStack().resolveStack();
+        client.get(15,TimeUnit.SECONDS);Assert.assertEquals(opp.getLife(),17);Assert.assertTrue(game.getCardState(bolt).isInZone(ZoneType.Graveyard));
+        Assert.assertTrue(Files.readString(dir.resolve("transcript.jsonl")).contains("targets"));
+    }
+    @Test public void externalTypeChoiceIsValidatedAndAudited()throws Exception{
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1);Card c=addCardToZone("Arcane Adaptation",me,ZoneType.Hand);
+        Path dir=Files.createTempDirectory("forge-bridge-type");System.setProperty("forge.audit.directory",dir.resolve("audit").toString());
+        PlayerControllerBridge bridge=remote(me,dir);Future<?> client=reply(dir,q->{JsonObject r=new JsonObject();r.addProperty("type","Ninja");return r;},1);
+        String type=bridge.chooseSomeType("Creature",c.getSpellAbilities().get(0),List.of("Human","Ninja","Dragon"),false);
+        client.get(15,TimeUnit.SECONDS);Assert.assertEquals(type,"Ninja");
+        Assert.assertTrue(Files.readString(dir.resolve("audit/seat-"+me.getId()+".jsonl")).contains("chosen_type"));
+    }
+    @Test public void invalidPriorityIndexDoesNotCastAnything()throws Exception{
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1);addCard("Mountain",me);Card bolt=addCardToZone("Lightning Bolt",me,ZoneType.Hand);
+        Path dir=Files.createTempDirectory("forge-bridge-invalid");PlayerControllerBridge bridge=remote(me,dir);
+        Future<?> client=reply(dir,q->{JsonObject r=new JsonObject();r.addProperty("index",1000000);return r;},1);
+        Assert.expectThrows(IllegalArgumentException.class,bridge::chooseSpellAbilityToPlay);
+        client.get(15,TimeUnit.SECONDS);Assert.assertTrue(bolt.isInZone(ZoneType.Hand));Assert.assertTrue(game.getStack().isEmpty());
+    }
+    @Test public void externalAttackPassesEngineConstraints()throws Exception{
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        Card bear=addCard("Runeclaw Bear",me);bear.setSickness(false);
+        game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS,me);Combat combat=new Combat(me);game.getPhaseHandler().setCombat(combat);
+        Path dir=Files.createTempDirectory("forge-bridge-attack");PlayerControllerBridge bridge=remote(me,dir);
+        Future<?> client=reply(dir,q->{JsonObject r=new JsonObject();JsonArray pairs=new JsonArray();pairs.add(bear.getId()+":"+opp.getId());r.add("pairs",pairs);return r;},1);
+        bridge.declareAttackers(me,combat);client.get(15,TimeUnit.SECONDS);Assert.assertTrue(combat.isAttacking(bear));Assert.assertEquals(combat.getDefenderByAttacker(bear),opp);
+    }
+    @Test public void staleResponseIsRejected()throws Exception{
+        Path dir=Files.createTempDirectory("forge-bridge-stale");System.setProperty("forge.bridge.timeoutSeconds","5");BridgeChannel channel=new BridgeChannel(dir);
+        Future<?> client=clients.submit(()->{try{
+            long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(5);while(!Files.exists(dir.resolve("request.json"))&&System.nanoTime()<deadline)Thread.sleep(10);
+            BridgeChannel.writeAtomic(dir.resolve("response.json"),"{\"request_id\":\"stale\",\"index\":-1}");
+        }catch(Exception e){throw new RuntimeException(e);}});
+        Assert.expectThrows(IllegalArgumentException.class,()->channel.ask(new JsonObject()));client.get(10,TimeUnit.SECONDS);
+    }
+    @Test public void rulesAllowEqualValueNinjutsuWhileStockPilotRejectsIt(){
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        addCard("Island",me);Card bear=addCard("Runeclaw Bear",me);bear.setSickness(false);
+        Card hacker=addCardToZone("Moon-Circuit Hacker",me,ZoneType.Hand);
+        game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS,me);
+        Combat combat=new Combat(me);combat.addAttacker(bear,opp);combat.setBlocked(bear,false);game.getPhaseHandler().setCombat(combat);
+        game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_BLOCKERS,me,false);
+        SpellAbility sa=forge.ai.ComputerUtilAbility.getSpellAbilities(new forge.game.card.CardCollection(hacker),me).stream().filter(SpellAbility::isNinjutsu).findFirst().orElseThrow();
+        sa.setActivatingPlayer(me);Assert.assertEquals(bear.getCMC(),hacker.getCMC());
+        Assert.assertTrue(sa.canPlay(),"Rules engine must allow the equal-value activation");
+        Assert.assertEquals(((forge.ai.PlayerControllerAi)me.getController()).getAi().canPlaySa(sa),forge.ai.AiPlayDecision.CantPlayAi);
+    }
+    @Test public void upkeepWithoutLandCandidatesCanPass()throws Exception{
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1);
+        game.getPhaseHandler().devModeSet(PhaseType.UPKEEP,me);
+        Path dir=Files.createTempDirectory("forge-bridge-upkeep");PlayerControllerBridge bridge=remote(me,dir);
+        Future<?> client=reply(dir,q->{JsonObject r=new JsonObject();r.addProperty("index",-1);return r;},1);
+        Assert.assertNull(bridge.chooseSpellAbilityToPlay());client.get(15,TimeUnit.SECONDS);
+    }
+
+}
diff --git a/forge-gui-desktop/src/test/java/forge/ai/ggs/GgsPilotTest.java b/forge-gui-desktop/src/test/java/forge/ai/ggs/GgsPilotTest.java
