+    @Test public void defenseSourceIndexKeepsTapAvailabilityAndAmountsFresh() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card target=addCard("Grizzly Bears",player),healer=addCard("Samite Healer",player);
+        healer.setSickness(false);
+        var ability=healer.getSpellAbilities().stream().filter(sa->sa.getApi()==forge.game.ability.ApiType.PreventDamage).findFirst().orElseThrow();
+        ability.setActivatingPlayer(player);
+        var handler=game.getReplacementHandler();
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertEquals(ComputerUtil.possibleDamagePrevention(target),1);
+            Assert.assertFalse(handler.getReadOnlyCombatDefenseSources(player,forge.game.ability.ApiType.PreventDamage).contains(target));
+            healer.setTapped(true);Assert.assertEquals(ComputerUtil.possibleDamagePrevention(target),0);
+            healer.setTapped(false);ability.putParam("Amount","3");
+            Assert.assertEquals(ComputerUtil.possibleDamagePrevention(target),3);
+            String previous=System.getProperty("dragonmind.disableCombatDefenseIndex");
+            try {
+                System.setProperty("dragonmind.disableCombatDefenseIndex","true");
+                Assert.assertEquals(ComputerUtil.possibleDamagePrevention(target),3);
+            } finally {
+                if(previous==null)System.clearProperty("dragonmind.disableCombatDefenseIndex");
+                else System.setProperty("dragonmind.disableCombatDefenseIndex",previous);
+            }
+        }
+    }
+
+    @Test public void defenseSourceIndexRechecksManaAndAbilityApiChanges() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card skeleton=addCard("Drudge Skeletons",player),swamp=addCard("Swamp",player);
+        var ability=skeleton.getSpellAbilities().stream().filter(sa->sa.getApi()==forge.game.ability.ApiType.Regenerate).findFirst().orElseThrow();
+        var handler=game.getReplacementHandler();
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertTrue(ComputerUtil.canRegenerate(player,skeleton));
+            swamp.setTapped(true);Assert.assertFalse(ComputerUtil.canRegenerate(player,skeleton));
+            swamp.setTapped(false);Assert.assertTrue(ComputerUtil.canRegenerate(player,skeleton));
+            ability.setApi(forge.game.ability.ApiType.Pump);Assert.assertFalse(ComputerUtil.canRegenerate(player,skeleton));
+            ability.setApi(forge.game.ability.ApiType.Regenerate);Assert.assertTrue(ComputerUtil.canRegenerate(player,skeleton));
+        }
+    }
