+    @Test public void commanderPropertyDispatchKeepsPhasingAndNegationLive() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card host=addCard("Grizzly Bears",player);
+        Assert.assertFalse(host.hasProperty("IsCommander",player,host,null));
+        Assert.assertTrue(host.hasProperty("!IsCommander",player,host,null));
+        host.setCommander(true);Assert.assertTrue(host.hasProperty("IsCommander",player,host,null));
+        Assert.assertFalse(host.hasProperty("!IsCommander",player,host,null));
+        host.setPhasedOut(player);Assert.assertFalse(host.hasProperty("IsCommander",player,host,null));
+        Assert.assertTrue(host.hasProperty("phasedOutIsCommander",player,host,null));
+        Assert.assertTrue(host.hasProperty("!IsCommander",player,host,null));
+        host.setCommander(false);Assert.assertFalse(host.hasProperty("phasedOutIsCommander",player,host,null));
+        host.setCommander(true);host.setPhasedOut(null);
+        Assert.assertTrue(host.hasProperty("IsCommander",player,host,null));
+        Assert.assertFalse(host.hasProperty("phasedOutIsCommander",player,host,null));
+    }
+    @Test public void commanderPropertyDispatchUsesLiveCardAndPreservesPreparedSpellExclusion() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);var other=game.getPlayers().get(1);
+        Card host=addCard("Grizzly Bears",player);var old=forge.game.card.CardCopyService.getLKICopy(host);
+        game.addChangeZoneLKIInfo(old);host.setCommander(true);host.setController(other,game.getNextTimestamp());
+        Assert.assertTrue(host.isValid("Card.IsCommander",player,host,null));
+        Assert.assertFalse(old.isCommander());game.clearChangeZoneLKIInfo();
+        Assert.assertTrue(host.isValid("Card.IsCommander",player,host,null));
+        host.addAlternateState(CardStateName.PreparedSpell,false);host.setState(CardStateName.PreparedSpell,false);
+        player.getZone(ZoneType.Battlefield).remove(host);player.getZone(ZoneType.Exile).add(host);host.setZone(player.getZone(ZoneType.Exile));
+        Assert.assertFalse(host.isValid("Card.IsCommander",player,host,null));
+        Assert.assertTrue(host.isValid("!Card.IsCommander",player,host,null));
+        player.getZone(ZoneType.Exile).remove(host);player.getZone(ZoneType.Command).add(host);host.setZone(player.getZone(ZoneType.Command));
+        Assert.assertTrue(host.isValid("Card.IsCommander",player,host,null));
