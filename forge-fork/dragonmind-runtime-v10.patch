diff --git a/forge-gui-desktop/src/test/java/forge/view/RuntimeLifecycleTest.java b/forge-gui-desktop/src/test/java/forge/view/RuntimeLifecycleTest.java
new file mode 100644
--- /dev/null
+++ b/forge-gui-desktop/src/test/java/forge/view/RuntimeLifecycleTest.java
@@ -0,0 +1,18 @@
+package forge.view;
+import org.testng.annotations.Test;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+public class RuntimeLifecycleTest {
+ @Test public void checks() throws Exception {
+  if(TimeLimitedCodeBlock.runWithTimeout(()->7,1,TimeUnit.SECONDS)!=7)throw new AssertionError();
+  try{TimeLimitedCodeBlock.runWithTimeout(()->{throw new IllegalArgumentException("expected");},1,TimeUnit.SECONDS);throw new AssertionError();}catch(IllegalArgumentException expected){}
+  CountDownLatch entered=new CountDownLatch(1), stopped=new CountDownLatch(1);AtomicBoolean restored=new AtomicBoolean();
+  Thread caller=new Thread(()->{try{TimeLimitedCodeBlock.runWithTimeout(()->{entered.countDown();try{Thread.sleep(30000);}finally{stopped.countDown();}return 1;},30,TimeUnit.SECONDS);throw new AssertionError();}catch(InterruptedException expected){restored.set(Thread.currentThread().isInterrupted());}catch(Exception e){throw new RuntimeException(e);}});
+  caller.start();if(!entered.await(2,TimeUnit.SECONDS))throw new AssertionError("task never started");caller.interrupt();caller.join(3000);
+  if(caller.isAlive()||!restored.get()||!stopped.await(2,TimeUnit.SECONDS))throw new AssertionError("interrupted task leaked");
+  CountDownLatch timedStopped=new CountDownLatch(1);
+  try{TimeLimitedCodeBlock.runWithTimeout(()->{try{Thread.sleep(30000);}finally{timedStopped.countDown();}return 1;},20,TimeUnit.MILLISECONDS);throw new AssertionError();}catch(TimeoutException expected){}
+  if(!timedStopped.await(2,TimeUnit.SECONDS))throw new AssertionError("timeout task leaked");
+  System.out.println("Runtime lifecycle checks passed: 4");
+ }
+}
