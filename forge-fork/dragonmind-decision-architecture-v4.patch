diff --git a/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java b/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java
index c33cbf6..e47dd56 100644
--- a/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java
+++ b/forge-gui-desktop/src/test/java/forge/ai/DragonMindPerformanceTest.java
@@ -20,6 +20,37 @@ import org.testng.Assert;
 import org.testng.annotations.Test;
 
 public class DragonMindPerformanceTest extends AITest {
+    @Test public void combatInspectionRechecksEffectsAndInvalidatesNestedMutations() {
+        var game=initAndCreateGame();var player=game.getPlayers().get(0);
+        Card source=addCard("Grizzly Bears",player),target=addCard("Grizzly Bears",player);
+        var handler=game.getReplacementHandler();
+        var params=AbilityKey.mapFromAffected(target);
+        params.put(AbilityKey.DamageSource,source);params.put(AbilityKey.DamageAmount,2);
+        params.put(AbilityKey.IsCombat,true);
+        var effect=ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Battlefield | Prevent$ True",target,false,null);
+        target.addReplacementEffect(effect);
+        var expected=handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other);
+        Assert.assertTrue(expected.contains(effect));
+        try(var outer=handler.beginReadOnlyCombatInspection()) {
+            Assert.assertEquals(handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other),expected);
+            effect.setHasRun(true);
+            Assert.assertTrue(handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other).isEmpty());
+            effect.setHasRun(false);
+            try(var inner=handler.beginReadOnlyManaInspection()) {
+                source.addReplacementEffect(ReplacementHandler.parseReplacement("Event$ DamageDone | ActiveZones$ Battlefield | Prevent$ True",source,false,null));
+            }
+            Assert.assertEquals(handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other).size(),2);
+            game.getAction().moveToGraveyard(target,null);
+            Assert.assertFalse(handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other).contains(effect));
+        }
+        Card shield=addCard("Grizzly Bears",player);params.put(AbilityKey.Affected,shield);
+        try(var scope=handler.beginReadOnlyCombatInspection()) {
+            var original=handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other);
+            shield.setCounters(CounterType.getType("Shield"),1);
+            var indexed=handler.getReplacementList(ReplacementType.DamageDone,params,ReplacementLayer.Other);
+            Assert.assertTrue(indexed.size()>original.size());
+        }
+    }
     private ReplacementEffect replacement(Card host) {
         return ReplacementHandler.parseReplacement("Event$ Destroy | ActiveZones$ Battlefield | ValidCard$ Card.Self | Prevent$ True",host,false,null);
     }
