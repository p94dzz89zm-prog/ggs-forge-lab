+    @Test public void emptyCollectionBulkCopyPreservesOrderAndIndependentMembership() {
+        for (int size : List.of(0, 1, 8, 32, 128)) {
+            FCollection<Integer> source = new FCollection<>(), destination = new FCollection<>();
+            for (int i=0;i<size;i++) source.add(i);
+            Assert.assertEquals(destination.addAll(source),size>0);
+            Assert.assertEquals(new ArrayList<>(destination),new ArrayList<>(source));
+            Assert.assertFalse(destination.addAll(destination));
+            source.add(1000); Assert.assertFalse(destination.contains(1000));
+            if(size>0) {
+                Assert.assertFalse(destination.add(0)); destination.remove(Integer.valueOf(0));
+                Assert.assertFalse(destination.contains(0)); Assert.assertTrue(source.contains(0));
+            }
+            destination.clear();
+            Assert.assertTrue(destination.addAll(source));
+            Assert.assertEquals(new ArrayList<>(destination),new ArrayList<>(source));
+            destination.add(size); Assert.assertEquals(Collections.frequency(new ArrayList<>(destination),size),1);
+        }
+    }
