+    private static CardCollection collectSources(final Card source) {
+        // Build one ordered snapshot directly; avoid constructing and copying an
+        // intermediate aggregate. Source-first identity dedup also preserves LKI.
+        CardCollection list = new CardCollection(source);
+        for (ZoneType zone : ZoneType.STATIC_ABILITIES_SOURCE_ZONES) {
+            if (zone == ZoneType.Stack) {
+                list.addAll(source.getGame().getStackZone().getCards());
+            } else {
+                for (Player player : source.getGame().getPlayers()) list.addAll(player.getCardsIn(zone));
+            }
+        }
+        return list;
+    }
