+    /** Preserve the live-view contract while tracking every supported mutation. */
+    private Collection<KeywordInterface> trackedView(Collection<KeywordInterface> backing) {
+        return new java.util.AbstractCollection<>() {
+            @Override public int size() { return backing.size(); }
+            @Override public boolean contains(Object value) { return backing.contains(value); }
+            @Override public Iterator<KeywordInterface> iterator() {
+                Iterator<KeywordInterface> delegate = backing.iterator();
+                return new Iterator<>() {
+                    public boolean hasNext() { return delegate.hasNext(); }
+                    public KeywordInterface next() { return delegate.next(); }
+                    public void remove() { delegate.remove(); membershipChanged(); }
+                };
+            }
+            @Override public boolean add(KeywordInterface value) {
+                boolean changed = backing.add(value);
+                if (changed) membershipChanged();
+                return changed;
+            }
+            @Override public boolean remove(Object value) {
+                boolean changed = backing.remove(value);
+                if (changed) membershipChanged();
+                return changed;
+            }
+            @Override public void clear() {
+                backing.clear(); membershipChanged();
+            }
+        };
+    }
