+    @Test public void trackedLiveViewsInvalidateAfterBulkAndIteratorEdits() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        var collection=new KeywordCollection();var flying=collection.add("Flying");flying.addStaticAbility(trait(host,"Creature"));
+        var values=collection.getValues();Assert.assertEquals(applied(collection).size(),1);
+        values.removeIf(k->true);Assert.assertTrue(applied(collection).isEmpty());
+        var keyed=collection.getValues(forge.game.keyword.Keyword.FLYING);keyed.add(flying);Assert.assertEquals(applied(collection).size(),1);
+        var iterator=keyed.iterator();iterator.next();iterator.remove();Assert.assertTrue(applied(collection).isEmpty());
+        keyed.addAll(List.of(flying));Assert.assertEquals(applied(collection).size(),1);
+        values.retainAll(List.of());Assert.assertTrue(applied(collection).isEmpty());
+        keyed.add(flying);Assert.assertEquals(applied(collection).size(),1);keyed.removeAll(List.of(flying));Assert.assertTrue(applied(collection).isEmpty());
+    }
+    @Test public void mutableKeywordTraitsRemainFreshThroughRetainedSublists() {
+        var game=initAndCreateGame();Card host=addCard("Grizzly Bears",game.getPlayers().get(0));
+        var collection=new KeywordCollection();var keyword=collection.add("Flying");var first=trait(host,"Creature");var second=trait(host,"Creature.YouCtrl");
+        Assert.assertFalse(collection.hasStaticAbilities());
+        var traits=(List<StaticAbility>)keyword.getStaticAbilities();traits.add(first);Assert.assertEquals(applied(collection),List.of(first));
+        traits.subList(0,1).set(0,second);Assert.assertEquals(applied(collection),List.of(second));
+        traits.listIterator().add(first);Assert.assertEquals(applied(collection),List.of(first,second));
+        traits.subList(0,1).clear();Assert.assertEquals(applied(collection),List.of(second));
+        var it=traits.iterator();it.next();it.remove();Assert.assertFalse(collection.hasStaticAbilities());
+        var replacements=(List<ReplacementEffect>)keyword.getReplacements();var effect=replacement(host);
+        Assert.assertFalse(collection.hasReplacementEffects());replacements.add(effect);Assert.assertTrue(collection.hasReplacementEffects());
+        Assert.assertEquals(collection.applyReplacementEffect(new ArrayList<>()),List.of(effect));
+        replacements.removeIf(e->true);Assert.assertFalse(collection.hasReplacementEffects());
+        var copied=keyword.copy(host,true);collection.clear();collection.insert(copied);Assert.assertFalse(collection.hasStaticAbilities());
+        copied.addStaticAbility(first);Assert.assertEquals(applied(collection),List.of(first));
+    }
