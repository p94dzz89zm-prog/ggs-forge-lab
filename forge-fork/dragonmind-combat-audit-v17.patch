+    @Test public void snapshotRecordsCombatRelationsWithoutRevealingFaceDownIdentity(){
+        Game game=initAndCreateGame();Player me=game.getPlayers().get(1),opp=game.getPlayers().get(0);
+        Card attacker=addCard("Grizzly Bears",me),unblocked=addCard("Phoenix Chick",me);
+        Card blocker=addCard("Fallen Shinobi",opp);blocker.turnFaceDown(true);
+        Combat combat=new Combat(me);combat.addAttacker(attacker,opp);combat.addAttacker(unblocked,opp);
+        combat.addBlocker(attacker,blocker);combat.setBlocked(attacker,true);combat.setBlocked(unblocked,false);
+        game.getPhaseHandler().setCombat(combat);
+        var snapshot=BridgeSnapshot.forPlayer(me);Assert.assertFalse(snapshot.toString().contains("Fallen Shinobi"));
+        var relations=snapshot.getAsJsonObject("combat").getAsJsonArray("attackers");Assert.assertEquals(relations.size(),2);
+        var blocked=relations.get(0).getAsJsonObject();Assert.assertEquals(blocked.get("attacker_id").getAsInt(),attacker.getId());
+        Assert.assertEquals(blocked.get("defender_id").getAsInt(),opp.getId());Assert.assertEquals(blocked.get("defender_kind").getAsString(),"player");
+        Assert.assertTrue(blocked.get("blocked").getAsBoolean());Assert.assertFalse(blocked.get("unblocked").getAsBoolean());
+        Assert.assertEquals(blocked.getAsJsonArray("blocker_ids").get(0).getAsInt(),blocker.getId());
+        Assert.assertTrue(relations.get(1).getAsJsonObject().get("unblocked").getAsBoolean());
+        game.getPhaseHandler().setCombat(null);Assert.assertFalse(BridgeSnapshot.forPlayer(me).has("combat"));
+    }
