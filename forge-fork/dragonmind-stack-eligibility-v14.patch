+        var local=(ThreadLocal<?>)field.get(null);Assert.assertNull(local.get());
+        try{
+            try(var outer=StackCandidateEligibility.search()){
+                StackCandidateEligibility.predict(candidate,p);var cache=local.get();Assert.assertNotNull(cache);
+                try(var inner=StackCandidateEligibility.search()){StackCandidateEligibility.predict(candidate,p);}
+                Assert.assertSame(local.get(),cache);throw new IllegalStateException("exercise cleanup");
+            }
