+    private void compareOriginal(Card card,forge.game.player.Player player){
+        var sa=card.getFirstSpellAbility();sa.setActivatingPlayer(player);
+        String previous=System.getProperty("dragonmind.disableStackCandidateEligibility");
+        try{
+            System.setProperty("dragonmind.disableStackCandidateEligibility","true");
+            var expected=signature(forge.game.GameActionUtil.getAlternativeCosts(sa,player,false));
+            System.clearProperty("dragonmind.disableStackCandidateEligibility");
+            Assert.assertEquals(signature(forge.game.GameActionUtil.getAlternativeCosts(sa,player,false)),expected);
+        }finally{if(previous==null)System.clearProperty("dragonmind.disableStackCandidateEligibility");else System.setProperty("dragonmind.disableStackCandidateEligibility",previous);}
+    }
