@@ -0,0 +1,23 @@
+package forge.ai.ggs;
+
+import forge.game.card.Card;
+import forge.game.trigger.TriggerType;
+
+/** Reads rules conditions rather than treating the commander as a generic body.
+ * Deliberately narrow: identifies the fresh-creature combat-token engine family.
+ * Other commander plans require additional interpreters, not guessed bonuses.
+ */
+public final class CommanderEngineProfile {
+    private CommanderEngineProfile() {}
+    public static boolean needsFreshCombatConnection(Card card) {
+        if(card.isPhasedOut())return false;
+        for(var trigger:card.getTriggers()) {
+            if(trigger.getMode()==TriggerType.DamageDoneOnce
+                    && "True".equals(trigger.getParamOrDefault("CombatDamage","False"))
+                    && trigger.getParamOrDefault("ValidSource","").contains("Creature.YouCtrl+ThisTurnEntered")
+                    && "Player".equals(trigger.getParamOrDefault("ValidTarget",""))
+                    && card.getSVar(trigger.getParamOrDefault("Execute","")).contains("TokenScript$ r_5_5_dragon_spirit_flying"))return true;
+        }
+        return false;
+    }
+}
