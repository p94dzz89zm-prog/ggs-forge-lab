+    /** Ordered complete cost sources; callers still inspect live abilities and conditions. */
+    public CardCollectionView getReadOnlyCombatCostSources() {
+        ManaSources snapshot = manaInspection.get();
+        boolean cache = snapshot != null && !snapshot.invalidated && snapshot.combat
+            && !Boolean.getBoolean("dragonmind.disableCombatCostIndex");
+        if (cache && snapshot.combatCostSources != null) return snapshot.combatCostSources;
+        CardCollection sources = new CardCollection(game.getCardsIn(ZoneType.Battlefield));
+        sources.addAll(game.getCardsIn(ZoneType.Stack));
+        sources.addAll(game.getCardsIn(ZoneType.Command));
+        if (cache && !snapshot.invalidated) snapshot.combatCostSources = sources;
+        return sources;
     }

